# Security
SECRET_KEY=django-insecure-slap-my-enemy-virtual-arena-super-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# AI Configuration
# Leave GEMINI_API_KEY blank to automatically run in offline mock caricature generator mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (SQLite by default for local development)
DATABASE_URL=sqlite:///db.sqlite3
